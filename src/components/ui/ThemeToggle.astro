---
// src/components/ui/ThemeToggle.astro
// 调色板图标按钮 + 弹出主题选择菜单(为多配色主题预留:加 themes 数组项即可)
// 桌面 header 与移动抽屉共用
import Icon from '../common/Icon.astro';
import { t } from '@i18n/utils';
import type { Locale } from '@i18n/config';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const themes = [
  { id: 'light', label: t(locale, 'theme.light') },
  { id: 'dark', label: t(locale, 'theme.dark') },
];
---

<div class="themeswitch" data-hover-panel>
  <button
    type="button"
    class="themeswitch-btn"
    data-theme-toggle
    aria-haspopup="true"
    aria-expanded="false"
    aria-label={t(locale, 'theme.label')}
    title={t(locale, 'theme.label')}
  >
    <Icon name="palette" size={20} />
  </button>
  <div
    class="themeswitch-menu panel-shell"
    data-theme-menu
    hidden
    role="menu"
    aria-label={t(locale, 'theme.label')}
  >
    {
      themes.map((th) => (
        <button
          type="button"
          role="menuitemradio"
          class="themeswitch-item panel-shell-item"
          data-theme-option={th.id}
          aria-checked="false"
        >
          {th.label}
        </button>
      ))
    }
  </div>
</div>

<script>
  import { wipeToTheme, primeWallpapers, type Theme } from '@lib/theme-wipe';

  // 主题应用:与旧 ThemeToggle 保持同一事件契约(theme-change,giscus 依赖它同步暗色)
  function currentTheme(): string {
    return document.documentElement.getAttribute('data-theme') ?? 'light';
  }
  function applyTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
    document.dispatchEvent(new CustomEvent('theme-change', { detail: { theme } }));
  }
  // 切换走覆盖层圆扩散:圆铺满后 commit 翻主题色,然后揭层。
  // 菜单高亮放进 commit —— 主题真正落定的时刻才更新,而不是点击的瞬间
  function applyThemeWithWipe(theme: string, event: MouseEvent) {
    void wipeToTheme(theme as Theme, {
      commit: () => {
        applyTheme(theme);
        syncMenus();
      },
      event,
    });
  }
  function syncMenus() {
    const cur = currentTheme();
    document.querySelectorAll<HTMLElement>('.themeswitch').forEach((wrap) => {
      wrap.querySelectorAll<HTMLButtonElement>('[data-theme-option]').forEach((opt) => {
        const active = opt.dataset.themeOption === cur;
        opt.classList.toggle('active', active);
        opt.setAttribute('aria-checked', String(active));
      });
    });
  }
  function setWrapOpen(wrap: HTMLElement, open: boolean) {
    const menu = wrap.querySelector<HTMLElement>('[data-theme-menu]');
    const btn = wrap.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (!menu || !btn) return;
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    if (open) syncMenus();
  }
  function initThemeSwitches() {
    document.querySelectorAll<HTMLElement>('.themeswitch').forEach((wrap) => {
      if (wrap.dataset.initialized === 'true') return;
      wrap.dataset.initialized = 'true';
      const btn = wrap.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const menu = wrap.querySelector<HTMLElement>('[data-theme-menu]');
      if (!btn || !menu) return;
      btn.addEventListener('click', (e) => {
        e.stopPropagation(); // 防止同一 click 冒泡到 document 立即收起
        setWrapOpen(wrap, menu.hidden);
      });
      // 悬停开合(机制在 src/lib/hover-panels.ts)
      wrap.addEventListener('hoverpanel:open', () => setWrapOpen(wrap, true));
      wrap.addEventListener('hoverpanel:close', () => setWrapOpen(wrap, false));
      menu.addEventListener('click', (e) => {
        const opt = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-theme-option]');
        if (!opt) return;
        applyThemeWithWipe(opt.dataset.themeOption as string, e);
        setWrapOpen(wrap, false);
        btn.focus();
      });
    });
    syncMenus();
  }
  // document 级监听只绑一次,处理函数内动态查询当前 DOM,避免随导航累积
  const CLOSE_FLAG = '__theme_menu_close_bound__';
  const closeWindow = window as unknown as Record<string, unknown>;
  if (!closeWindow[CLOSE_FLAG]) {
    closeWindow[CLOSE_FLAG] = true;
    document.addEventListener('click', (e) => {
      document.querySelectorAll<HTMLElement>('.themeswitch').forEach((wrap) => {
        if (!wrap.contains(e.target as Node)) setWrapOpen(wrap, false);
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      document.querySelectorAll<HTMLElement>('.themeswitch').forEach((wrap) => {
        const menu = wrap.querySelector<HTMLElement>('[data-theme-menu]');
        if (menu && !menu.hidden) {
          setWrapOpen(wrap, false);
          wrap.querySelector<HTMLButtonElement>('[data-theme-toggle]')?.focus();
        }
      });
    });
  }
  // 主动解码两张壁纸:覆盖层引用同一 URL,解码缓存命中圆扩散第一帧才不是空白。
  // 每次导航都跑一次(ClientRouter 换页后图片元素是新的)
  document.addEventListener('astro:page-load', () => {
    initThemeSwitches();
    primeWallpapers();
  });
</script>

<style>
  .themeswitch {
    position: relative;
  }
  .themeswitch-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color calc(var(--duration-fast) * var(--motion-scale)) var(--ease-out);
  }
  .themeswitch-btn:hover,
  .themeswitch-btn[aria-expanded='true'] {
    color: var(--color-accent);
  }
  /* 材质/圆角/内边距/行样式来自 styles/header-panels.css 的 .panel-shell + .panel-shell-item,
     这里只管位置与宽度 */
  .themeswitch-menu {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    min-width: 140px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    z-index: 10;
  }
  .themeswitch-menu[hidden] {
    display: none;
  }
  .themeswitch-item.active {
    color: var(--color-accent);
    font-weight: 600;
  }
</style>
