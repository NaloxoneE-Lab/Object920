---
// src/components/ui/MobileNav.astro
// 多实例安全:首页第二屏面板会再挂一个 Header,抽屉状态全部按实例作用域存取,
// 禁用跨实例的 getElementById(id 由 render 时随机生成保证唯一)
import Icon from '../common/Icon.astro';
import { t } from '@i18n/utils';
import { siteConfig } from '@config/site';
import type { Locale } from '@i18n/config';
import LangSwitch from '../common/LangSwitch.astro';
import MusicPlayerWidget from '@components/integrations/music/MusicPlayerWidget.astro';
import ThemeToggle from './ThemeToggle.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const uid = `mn-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="mobile-nav">
  <button
    type="button"
    class="mobile-nav-toggle"
    aria-expanded="false"
    aria-controls={`${uid}-drawer`}
  >
    <Icon name="menu" size={24} class="icon-menu" />
    <Icon name="close" size={24} class="icon-close" />
  </button>
  <!-- 裁剪根容器:fixed inset:0 + overflow:hidden,把关闭态停在视口外的抽屉
     裁在自己内部。否则 fixed 盒会撑出文档横向滚动区,页面可左右拖动 -->
  <div class="mobile-nav-root" id={`${uid}-root`}>
    <div class="mobile-nav-overlay" hidden></div>
    <nav class="mobile-nav-drawer" id={`${uid}-drawer`} aria-label={t(locale, 'nav.home')}>
      <ul class="mobile-nav-list">
        {
          siteConfig.navItems.map((item) => (
            <li>
              <a href={`/${locale}${item.href}`} class="mobile-nav-link">
                {t(locale, item.key)}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mobile-nav-controls">
        <MusicPlayerWidget locale={locale} />
        <LangSwitch locale={locale} />
        <ThemeToggle locale={locale} />
      </div>
    </nav>
  </div>
</div>
<script>
  // ClientRouter 导航重建 DOM:元素级绑定随 astro:page-load 重进(带实例守卫);
  // document 级 Escape 只绑一次,处理时关闭所有处于打开态的抽屉实例
  function closeMobileNav(scope: HTMLElement) {
    const toggle = scope.querySelector<HTMLElement>('.mobile-nav-toggle');
    const root = scope.querySelector<HTMLElement>('.mobile-nav-root');
    const overlay = scope.querySelector<HTMLElement>('.mobile-nav-overlay');
    if (!toggle || !root || !overlay) return;
    toggle.setAttribute('aria-expanded', 'false');
    root.classList.remove('open');
    overlay.hidden = true;
    document.body.style.overflow = '';
  }
  function initMobileNav() {
    document.querySelectorAll<HTMLElement>('.mobile-nav').forEach((scope) => {
      const toggle = scope.querySelector<HTMLElement>('.mobile-nav-toggle');
      const root = scope.querySelector<HTMLElement>('.mobile-nav-root');
      const overlay = scope.querySelector<HTMLElement>('.mobile-nav-overlay');
      if (!toggle || !root || !overlay) return;
      if (toggle.dataset.initialized === 'true') return;
      toggle.dataset.initialized = 'true';
      const isOpen = () => root.classList.contains('open');
      toggle.addEventListener('click', () => {
        if (isOpen()) {
          closeMobileNav(scope);
        } else {
          toggle.setAttribute('aria-expanded', 'true');
          root.classList.add('open');
          overlay.hidden = false;
          document.body.style.overflow = 'hidden';
        }
      });
      overlay.addEventListener('click', () => closeMobileNav(scope));
    });
  }
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll<HTMLElement>('.mobile-nav').forEach((scope) => closeMobileNav(scope));
  });
  document.addEventListener('astro:page-load', initMobileNav);
</script>
<style>
  .mobile-nav-toggle {
    display: none;
  }
  .mobile-nav-root {
    display: none;
  }
  @media (max-width: 768px) {
    .mobile-nav-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border: none;
      background: transparent;
      color: var(--color-text-muted);
      cursor: pointer;
    }
    .mobile-nav-toggle :global(.icon-close) {
      display: none;
    }
    .mobile-nav-toggle[aria-expanded='true'] :global(.icon-menu) {
      display: none;
    }
    .mobile-nav-toggle[aria-expanded='true'] :global(.icon-close) {
      display: block;
    }
    .mobile-nav-root {
      display: block;
      position: fixed;
      /* 注意:header 的 backdrop-filter 使其成为 fixed 后代的包含块,
         inset:0 会被解析成 header 盒子而非视口,必须显式给满视口尺寸 */
      top: 0;
      left: 0;
      right: 0;
      height: 100vh;
      height: 100dvh;
      overflow: hidden;
      /* 关闭态:根容器整体移出命中测试与焦点序列;visibility 延迟到滑出动画结束后再隐藏 */
      pointer-events: none;
      visibility: hidden;
      z-index: var(--z-overlay);
      transition: visibility 0s linear calc(var(--duration-slow) * var(--motion-scale));
    }
    .mobile-nav-root.open {
      pointer-events: auto;
      visibility: visible;
      transition: visibility 0s;
    }
    .mobile-nav-overlay {
      position: absolute;
      inset: 0;
      background: var(--color-surface-overlay);
    }
    .mobile-nav-overlay[hidden] {
      display: none;
    }
    .mobile-nav-drawer {
      position: absolute;
      top: 0;
      right: 0;
      width: 280px;
      height: 100%;
      display: flex;
      flex-direction: column;
      background: var(--color-surface-raised);
      padding: var(--spacing-lg);
      transform: translateX(100%);
      transition: transform calc(var(--duration-slow) * var(--motion-scale)) var(--ease-out);
    }
    .mobile-nav-root.open .mobile-nav-drawer {
      transform: translateX(0);
    }
    .mobile-nav-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: var(--spacing-sm);
    }
    .mobile-nav-link {
      color: var(--color-text);
      text-decoration: none;
      font-size: var(--text-md);
    }
    .mobile-nav-controls {
      display: flex;
      gap: var(--spacing-md);
      margin-top: var(--spacing-xl);
    }
  }
</style>
