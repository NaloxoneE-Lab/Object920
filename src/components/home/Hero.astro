---
// src/components/home/Hero.astro
// 仿Sakura 首页第一屏 — 严格按 docs/design/hero-home-spec.md + Penpot 画板实测几何:
//   左侧菜单 x=240、首项顶 y=228、行距 76px(34px 行高 + 42px 间隔)、细线在项顶+44px/56px 宽
//   底部双箭头错位 28px(上层 100%/下层 40%),上层顶 y≈678
// 顶栏与背景已上移:常驻顶栏由 layout/Header.astro 提供(fixed,与全站统一),
// 壁纸由 BaseLayout 的 site-bg 层全局铺底,本组件透明浮于其上。
import { t } from '@i18n/utils';
import { siteConfig } from '@config/site';
import type { Locale } from '@i18n/config';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const menuItems = siteConfig.navItems.filter((item) => item.key !== 'nav.home');
const enLabels: Record<string, string> = {
  'nav.articles': 'ARTICLES',
  'nav.projects': 'PROJECTS',
  'nav.favorites': 'FAVORITES',
  'nav.friends': 'FRIENDS',
  'nav.about': 'ABOUT',
};
---

<section class="sakura-hero" data-sakura-hero>
  <nav class="sakura-menu" aria-label={t(locale, 'nav.home')}>
    {
      menuItems.map((item) => (
        <a href={`/${locale}${item.href}`} class="sakura-item">
          <span class="sakura-item-zh">{t(locale, item.key)}</span>
          <span class="sakura-item-en" aria-hidden="true">
            {enLabels[item.key]}
          </span>
          <span class="sakura-item-line" aria-hidden="true" />
        </a>
      ))
    }
  </nav>

  <button
    type="button"
    class="sakura-scroll"
    data-sakura-scroll
    aria-label={t(locale, 'hero.scrollDown')}
  >
    <svg
      width="42"
      height="62"
      viewBox="0 0 42 62"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M5 8 L21 24 L37 8"></path>
      <path d="M5 36 L21 52 L37 36" opacity="0.4"></path>
    </svg>
  </button>
</section>

<script>
  import { switchToPanel } from './scroll-switch';
  // 滚动指示:走双屏开关动画(scroll-switch);绑定随 astro:page-load 重进(实例守卫)
  document.addEventListener('astro:page-load', () => {
    const hero = document.querySelector<HTMLElement>('[data-sakura-hero]');
    if (!hero || hero.dataset.scrollBound === 'true') return;
    hero.dataset.scrollBound = 'true';
    hero.querySelector('[data-sakura-scroll]')?.addEventListener('click', () => {
      switchToPanel();
    });
  });
</script>

<style>
  .sakura-hero {
    /* 墨色取全局壁纸墨色 token(tokens.css:亮 26 26 29 / 暗 232 232 234) */
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    /* 未配置全站壁纸时的回退底色(配置了则透明,壁纸由 site-bg 层提供) */
    background: linear-gradient(160deg, #faf6f4 0%, #f5edea 55%, #efe4e2 100%);
  }
  :global([data-theme='dark']) .sakura-hero {
    background: linear-gradient(160deg, #161319 0%, #1b171f 55%, #211a21 100%);
  }
  :global(body.has-site-bg) .sakura-hero {
    background: transparent;
  }

  /* === 左侧菜单(设计稿实测:x=240,首项顶 228,行距 76,细线 项顶+44/56px)=== */
  .sakura-menu {
    position: absolute;
    left: clamp(24px, 16.67vw, 240px);
    /* 菜单块高 4*76+34=338,块中心比板中心高 8px → 50%-169-8 */
    top: calc(50% - 177px);
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 42px;
  }
  .sakura-item {
    position: relative;
    display: flex;
    align-items: flex-end;
    height: 34px;
    text-decoration: none;
    color: rgb(var(--hero-ink) / 0.9);
  }
  .sakura-item-zh {
    font-size: 28px;
    font-weight: 500;
    line-height: 34px;
    font-family: 'Noto Sans SC', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
    transition: color calc(var(--duration-fast) * var(--motion-scale)) var(--ease-out);
  }
  .sakura-item-en {
    margin-left: 5px; /* 设计稿:en x=302,zh 右缘 297 */
    font-size: 11px;
    font-weight: 400;
    line-height: 14px;
    letter-spacing: 2px;
    font-family: Rubik, 'Segoe UI', system-ui, sans-serif;
    color: rgb(var(--hero-ink) / 0.35);
  }
  .sakura-item-line {
    position: absolute;
    top: 44px; /* 项顶 + 44(设计稿细线顶=首项顶+44) */
    left: 0;
    width: 56px;
    height: 1px;
    background: rgb(var(--hero-ink) / 0.1);
    transition:
      height calc(var(--duration-fast) * var(--motion-scale)) var(--ease-out),
      background calc(var(--duration-fast) * var(--motion-scale)) var(--ease-out);
  }
  .sakura-item:hover .sakura-item-line,
  .sakura-item:focus-visible .sakura-item-line {
    height: 2px;
    background: rgb(var(--hero-ink) / 0.9);
  }
  .sakura-item:hover .sakura-item-zh {
    color: rgb(var(--hero-ink) / 1);
  }

  /* === 底部滚动指示(双箭头错位 28px,上层顶 y≈678 → bottom≈8.6vh)=== */
  .sakura-scroll {
    position: absolute;
    bottom: clamp(32px, 7.6vh, 88px); /* 设计稿:svg 顶 y≈678 @810 */
    left: 50%;
    translate: -50% 0;
    z-index: 1;
    padding: var(--spacing-2xs);
    border: none;
    background: none;
    color: rgb(var(--hero-ink));
    cursor: pointer;
    animation: sakura-float 2.6s var(--ease-out) infinite;
  }
  @keyframes sakura-float {
    0%,
    100% {
      translate: -50% 0;
    }
    50% {
      translate: -50% 8px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sakura-scroll {
      animation: none;
    }
  }

  /* === 双屏切换退场(body.home-at-panel,见 scroll-switch.ts):
     切向第二屏时 Hero 内容上浮淡出,返回第一屏时复位重放 === */
  .sakura-menu,
  .sakura-scroll {
    transition:
      opacity calc(var(--duration-slow) * var(--motion-scale)) var(--ease-out),
      translate calc(var(--duration-slow) * var(--motion-scale)) var(--ease-out);
  }
  :global(body.home-at-panel) .sakura-menu {
    opacity: 0;
    translate: 0 -26px;
  }
  /* 滚动箭头的悬浮动画与 translate 过渡冲突,退场态停用动画让位给过渡 */
  :global(body.home-at-panel) .sakura-scroll {
    opacity: 0;
    translate: -50% 14px;
    animation: none;
  }

  @media (max-width: 767.98px) {
    .sakura-menu {
      gap: 34px;
    }
    .sakura-item {
      height: 28px;
    }
    .sakura-item-zh {
      font-size: 22px;
      line-height: 28px;
    }
    .sakura-item-line {
      top: 38px;
    }
  }
</style>
