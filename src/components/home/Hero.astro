---
// src/components/home/Hero.astro
// 仿Sakura 首页 Hero(docs/design/hero-home-spec.md):
// 全屏浅色背景 + 左侧 galgame 式文字菜单(hover 细线加粗)+ 底部滚动指示。
// 背景默认自绘渐变(spec 的雪景占位图版权未确认,siteConfig.heroBackground 可换自有授权图)。
// 字体用系统栈近似(Noto Sans SC/PingFang/雅黑 + Rubik 回退),不引外部字体服务:
// CSP font-src 'self' 且规避 CJK 子集化与授权问题(与 spec §7 的偏差,已在交接报告注明)。
import { t } from '@i18n/utils';
import { siteConfig } from '@config/site';
import type { Locale } from '@i18n/config';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
// spec §4:五个主菜单项(排除"首页"自身),英文角标是固定设计元素
const menuItems = siteConfig.navItems.filter((item) => item.key !== 'nav.home');
const enLabels: Record<string, string> = {
  'nav.articles': 'ARTICLES',
  'nav.projects': 'PROJECTS',
  'nav.favorites': 'FAVORITES',
  'nav.friends': 'FRIENDS',
  'nav.about': 'ABOUT',
};
const bg = siteConfig.heroBackground;
---

<section class="sakura-hero" data-sakura-hero>
  {bg && <img class="sakura-bg" src={bg} alt="" fetchpriority="high" />}
  <nav class="sakura-menu" aria-label={t(locale, 'nav.home')}>
    {
      menuItems.map((item) => (
        <a href={`/${locale}${item.href}`} class="sakura-item">
          <span class="sakura-item-zh">{t(locale, item.key)}</span>
          <span class="sakura-item-en" aria-hidden="true">
            {enLabels[item.key]}
          </span>
          <span class="sakura-item-line" aria-hidden="true" />
        </a>
      ))
    }
  </nav>
  <button
    type="button"
    class="sakura-scroll"
    data-sakura-scroll
    aria-label={t(locale, 'hero.scrollDown')}
  >
    <svg
      width="42"
      height="58"
      viewBox="0 0 42 58"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path class="sakura-chevron-back" d="M6 22 L21 36 L36 22" opacity="0.4"></path>
      <path d="M6 8 L21 22 L36 8"></path>
    </svg>
  </button>
</section>

<script>
  // 滚动指示:平滑滚到 hero 下方栏目区;绑定随 astro:page-load 重进(实例守卫)
  document.addEventListener('astro:page-load', () => {
    const hero = document.querySelector<HTMLElement>('[data-sakura-hero]');
    if (!hero || hero.dataset.scrollBound === 'true') return;
    hero.dataset.scrollBound = 'true';
    hero.querySelector('[data-sakura-scroll]')?.addEventListener('click', () => {
      // 不用 nextElementSibling:Astro 的 hoisted script 会插在 hero 后面
      const top = hero.offsetTop + hero.offsetHeight;
      window.scrollTo({
        top,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      });
    });
  });
</script>

<style>
  .sakura-hero {
    /* 墨色按 spec:#1A1A1D(亮)/ #E8E8EA(暗),以 RGB 分量形式便于透明度组合 */
    --hero-ink: 26 26 29;
    position: relative;
    min-height: calc(100svh - 66px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: linear-gradient(160deg, #faf6f4 0%, #f5edea 55%, #efe4e2 100%);
  }
  :global([data-theme='dark']) .sakura-hero {
    --hero-ink: 232 232 234;
    background: linear-gradient(160deg, #161319 0%, #1b171f 55%, #211a21 100%);
  }
  .sakura-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .sakura-menu {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 42px;
    padding-left: clamp(24px, 16.7vw, 240px);
    padding-right: var(--spacing-md);
  }
  .sakura-item {
    text-decoration: none;
    color: rgb(var(--hero-ink) / 0.9);
  }
  .sakura-item-zh {
    font-size: 28px;
    font-weight: 500;
    line-height: 34px;
    font-family: 'Noto Sans SC', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
    transition: color calc(var(--duration-fast) * var(--motion-scale)) var(--ease-out);
  }
  .sakura-item-en {
    margin-left: 6px;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 2px;
    font-family: Rubik, 'Segoe UI', system-ui, sans-serif;
    color: rgb(var(--hero-ink) / 0.35);
  }
  .sakura-item-line {
    display: block;
    width: 56px;
    height: 1px;
    margin-top: 15px;
    background: rgb(var(--hero-ink) / 0.1);
    transition:
      height calc(var(--duration-fast) * var(--motion-scale)) var(--ease-out),
      background calc(var(--duration-fast) * var(--motion-scale)) var(--ease-out);
  }
  .sakura-item:hover .sakura-item-line,
  .sakura-item:focus-visible .sakura-item-line {
    height: 2px;
    background: rgb(var(--hero-ink) / 0.9);
  }
  .sakura-item:hover .sakura-item-zh {
    color: rgb(var(--hero-ink) / 1);
  }
  .sakura-scroll {
    position: absolute;
    bottom: var(--spacing-sm);
    left: 50%;
    translate: -50% 0;
    z-index: 1;
    padding: var(--spacing-2xs);
    border: none;
    background: none;
    color: rgb(var(--hero-ink) / 0.9);
    cursor: pointer;
    animation: sakura-float 2.6s var(--ease-out) infinite;
  }
  @keyframes sakura-float {
    0%,
    100% {
      translate: -50% 0;
    }
    50% {
      translate: -50% 8px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sakura-scroll {
      animation: none;
    }
  }
  @media (max-width: 768px) {
    .sakura-hero {
      min-height: calc(100svh - 60px);
    }
    .sakura-menu {
      gap: 28px;
    }
    .sakura-item-zh {
      font-size: 22px;
      line-height: 28px;
    }
  }
</style>
