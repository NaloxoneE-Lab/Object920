---
// src/components/home/Hero.astro
// 仿Sakura 首页 Hero — 严格按 docs/design/hero-home-spec.md + Penpot 画板实测几何:
//   顶栏 64px 透明层(logo x=40/24px/400;图标组右缘距右 40px、圆心距 44px、搜索光学 -2px)
//   左侧菜单 x=240、首项顶 y=228、行距 76px(34px 行高 + 42px 间隔)、细线在项顶+44px/56px 宽
//   背景 wallhaven-2y3e56(仅背景图层,从 Penpot fill 导出,2254×1268 webp)
//   底部双箭头错位 28px(上层 100%/下层 40%),上层顶 y≈678
// 桌面(≥768px)隐藏站点 Header(spec §1"页面即首页,无独立导航条");移动端保留 Header+抽屉(spec §8)
import { t } from '@i18n/utils';
import { siteConfig } from '@config/site';
import MusicPlayerWidget from '@components/integrations/music/MusicPlayerWidget.astro';
import SearchBox from '@components/integrations/search/SearchBox.astro';
import LangSwitch from '@components/common/LangSwitch.astro';
import ThemeToggle from '@components/ui/ThemeToggle.astro';
import type { Locale } from '@i18n/config';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const menuItems = siteConfig.navItems.filter((item) => item.key !== 'nav.home');
const enLabels: Record<string, string> = {
  'nav.articles': 'ARTICLES',
  'nav.projects': 'PROJECTS',
  'nav.favorites': 'FAVORITES',
  'nav.friends': 'FRIENDS',
  'nav.about': 'ABOUT',
};
const bg = siteConfig.heroBackground;
---

<section class="sakura-hero" data-sakura-hero>
  {
    bg && (
      <>
        <img class="sakura-bg" src={bg} alt="" fetchpriority="high" />
        <div class="sakura-bg-overlay" aria-hidden="true" />
      </>
    )
  }

  <header class="sakura-topbar">
    <a href={`/${locale}/`} class="sakura-logo">{siteConfig.brand}</a>
    <div class="sakura-topbar-icons">
      <MusicPlayerWidget locale={locale} />
      <SearchBox locale={locale} />
      <LangSwitch locale={locale} />
      <ThemeToggle locale={locale} />
    </div>
  </header>

  <nav class="sakura-menu" aria-label={t(locale, 'nav.home')}>
    {
      menuItems.map((item) => (
        <a href={`/${locale}${item.href}`} class="sakura-item">
          <span class="sakura-item-zh">{t(locale, item.key)}</span>
          <span class="sakura-item-en" aria-hidden="true">
            {enLabels[item.key]}
          </span>
          <span class="sakura-item-line" aria-hidden="true" />
        </a>
      ))
    }
  </nav>

  <button
    type="button"
    class="sakura-scroll"
    data-sakura-scroll
    aria-label={t(locale, 'hero.scrollDown')}
  >
    <svg
      width="42"
      height="62"
      viewBox="0 0 42 62"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M5 8 L21 24 L37 8"></path>
      <path d="M5 36 L21 52 L37 36" opacity="0.4"></path>
    </svg>
  </button>
</section>

<script>
  // 滚动指示:平滑滚过 hero;绑定随 astro:page-load 重进(实例守卫)
  document.addEventListener('astro:page-load', () => {
    const hero = document.querySelector<HTMLElement>('[data-sakura-hero]');
    if (!hero || hero.dataset.scrollBound === 'true') return;
    hero.dataset.scrollBound = 'true';
    hero.querySelector('[data-sakura-scroll]')?.addEventListener('click', () => {
      // 不用 nextElementSibling:Astro 的 hoisted script 会插在 hero 后面
      const top = hero.offsetTop + hero.offsetHeight;
      window.scrollTo({
        top,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      });
    });
  });
</script>

<style>
  .sakura-hero {
    /* 墨色按 spec:#1A1A1D(亮)/ #E8E8EA(暗),RGB 分量便于透明度组合 */
    --hero-ink: 26 26 29;
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: linear-gradient(160deg, #faf6f4 0%, #f5edea 55%, #efe4e2 100%);
  }
  :global([data-theme='dark']) .sakura-hero {
    --hero-ink: 232 232 234;
    background: linear-gradient(160deg, #161319 0%, #1b171f 55%, #211a21 100%);
  }
  .sakura-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  /* 背景图整体偏浅:暗色主题压暗保浅色墨字可读 */
  .sakura-bg-overlay {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: transparent;
  }
  :global([data-theme='dark']) .sakura-bg-overlay {
    background: linear-gradient(to bottom, rgb(10 10 14 / 78%), rgb(10 10 14 / 88%));
  }

  /* === 顶栏(64px 透明层,spec §3)=== */
  .sakura-topbar {
    /* 覆盖图标控件取色:墨色替代主题 muted/text;弹层面板仍用正常主题色 */
    --color-text-muted: rgb(var(--hero-ink) / 0.85);
    --color-text: rgb(var(--hero-ink));
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 64px;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 32px 0 40px; /* 右 32:34px 按钮 + 右缘 40 ≈ 设计稿图标圆心 x=1391 */
  }
  .sakura-logo {
    font-size: 24px;
    font-weight: 400;
    color: rgb(var(--hero-ink));
    text-decoration: none;
  }
  .sakura-topbar-icons {
    display: flex;
    align-items: center;
    gap: 10px; /* 34px 按钮圆心距 = 44px */
  }
  /* 控件包裹层收窄到按钮宽度,保证圆心严格等距 44px
     (子组件样式属各自 scoped 域,须 :global 覆写) */
  .sakura-topbar-icons > * {
    width: 34px;
    display: flex;
    justify-content: center;
  }
  .sakura-topbar-icons :global(.search-box) {
    width: 34px;
  }
  /* 搜索光学中心比其余高 2px(spec §3.2);按钮归一 34px 保证圆心等距 44px */
  .sakura-topbar :global(.search-box .search-toggle) {
    width: 34px;
    height: 34px;
    translate: 0 -2px;
  }

  /* === 左侧菜单(设计稿实测:x=240,首项顶 228,行距 76,细线 项顶+44/56px)=== */
  .sakura-menu {
    position: absolute;
    left: clamp(24px, 16.67vw, 240px);
    /* 菜单块高 4*76+34=338,块中心比板中心高 8px → 50%-169-8 */
    top: calc(50% - 177px);
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 42px;
  }
  .sakura-item {
    position: relative;
    display: flex;
    align-items: flex-end;
    height: 34px;
    text-decoration: none;
    color: rgb(var(--hero-ink) / 0.9);
  }
  .sakura-item-zh {
    font-size: 28px;
    font-weight: 500;
    line-height: 34px;
    font-family: 'Noto Sans SC', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
    transition: color calc(var(--duration-fast) * var(--motion-scale)) var(--ease-out);
  }
  .sakura-item-en {
    margin-left: 5px; /* 设计稿:en x=302,zh 右缘 297 */
    font-size: 11px;
    font-weight: 400;
    line-height: 14px;
    letter-spacing: 2px;
    font-family: Rubik, 'Segoe UI', system-ui, sans-serif;
    color: rgb(var(--hero-ink) / 0.35);
  }
  .sakura-item-line {
    position: absolute;
    top: 44px; /* 项顶 + 44(设计稿细线顶=首项顶+44) */
    left: 0;
    width: 56px;
    height: 1px;
    background: rgb(var(--hero-ink) / 0.1);
    transition:
      height calc(var(--duration-fast) * var(--motion-scale)) var(--ease-out),
      background calc(var(--duration-fast) * var(--motion-scale)) var(--ease-out);
  }
  .sakura-item:hover .sakura-item-line,
  .sakura-item:focus-visible .sakura-item-line {
    height: 2px;
    background: rgb(var(--hero-ink) / 0.9);
  }
  .sakura-item:hover .sakura-item-zh {
    color: rgb(var(--hero-ink) / 1);
  }

  /* === 底部滚动指示(双箭头错位 28px,上层顶 y≈678 → bottom≈8.6vh)=== */
  .sakura-scroll {
    position: absolute;
    bottom: clamp(32px, 7.6vh, 88px); /* 设计稿:svg 顶 y≈678 @810 */
    left: 50%;
    translate: -50% 0;
    z-index: 1;
    padding: var(--spacing-2xs);
    border: none;
    background: none;
    color: rgb(var(--hero-ink));
    cursor: pointer;
    animation: sakura-float 2.6s var(--ease-out) infinite;
  }
  @keyframes sakura-float {
    0%,
    100% {
      translate: -50% 0;
    }
    50% {
      translate: -50% 8px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sakura-scroll {
      animation: none;
    }
  }

  /* 首页桌面隐藏站点 Header(spec §1:页面即首页,无独立导航条);移动保留(spec §8) */
  @media (min-width: 768px) {
    :global(body.page-home .header) {
      display: none;
    }
  }
  @media (max-width: 767.98px) {
    .sakura-topbar {
      display: none;
    }
    .sakura-hero {
      min-height: calc(100svh - 60px);
    }
    .sakura-menu {
      gap: 34px;
    }
    .sakura-item {
      height: 28px;
    }
    .sakura-item-zh {
      font-size: 22px;
      line-height: 28px;
    }
    .sakura-item-line {
      top: 38px;
    }
  }
</style>
