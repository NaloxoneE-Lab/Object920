---
// src/components/home/HomeArticleList.astro
// 首页文章图文列表:左文字块(标题/摘要/图标元信息行)+ 右侧满贴边封面
// (图的上/右/下三边与卡片边缘对齐,圆角由卡片 overflow 裁切)。
// 无封面的文章封面块不渲染、文字占满全宽;设计定稿见 Penpot「01 · 首页」1.2 画板。
import { Image } from 'astro:assets';
import Icon from '@components/common/Icon.astro';
import { formatDateISO, t } from '@i18n/utils';
import type { Locale } from '@i18n/config';
import { slugOf } from '@lib/i18n';
import { countWords, stripMarkdown } from '@lib/content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'articles'>[];
  locale: Locale;
}
const { entries, locale } = Astro.props;
---

<div class="home-article-list">
  {
    entries.map((entry) => {
      const { cover, coverAlt, title, excerpt, pubDate, category, tags } = entry.data;
      const wordCount = countWords(entry.body ?? '');
      const plainBody = stripMarkdown(entry.body ?? '')
        .replace(/\s+/g, ' ')
        .trim();
      const bodyPreview = plainBody.length > 120 ? `${plainBody.slice(0, 120)}…` : plainBody;
      const href = `/${locale}/articles/${slugOf(entry)}/`;
      return (
        <a href={href} class="home-article-row">
          <div class="home-article-body">
            <h3 class="home-article-title">{title}</h3>
            {excerpt && <p class="home-article-excerpt">{excerpt}</p>}
            <div class="home-article-meta">
              <span class="home-article-meta-item">
                <Icon name="calendar" size={14} />
                <time datetime={pubDate.toISOString()}>{formatDateISO(pubDate)}</time>
              </span>
              <span class="home-article-meta-item">
                <Icon name="folder" size={14} />
                {category}
              </span>
              <span class="home-article-meta-item">
                <Icon name="fileText" size={14} />
                {t(locale, 'articles.wordCount', { n: String(wordCount) })}
              </span>
              {tags.slice(0, 3).map((tag) => (
                <span class="home-article-meta-item">
                  <Icon name="tag" size={14} />#{tag}
                </span>
              ))}
            </div>
          </div>
          {cover && (
            <span class="home-article-cover-wrap">
              <Image
                src={cover}
                alt={coverAlt}
                width={540}
                height={304}
                loading="lazy"
                class="home-article-cover"
              />
              <span class="home-article-cover-frost" aria-hidden="true" />
              <span class="home-article-cover-preview-text" aria-hidden="true">
                {bodyPreview}
              </span>
            </span>
          )}
        </a>
      );
    })
  }
</div>

<style>
  .home-article-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .home-article-row {
    display: flex;
    gap: 24px;
    min-height: 200px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
  }
  .home-article-body {
    flex: 1;
    min-width: 0;
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .home-article-title {
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.25;
    /* 单行宽度比文字区多容纳 2 字:右界外扩 2em,伸进 gap 与封面左缘渐隐区 */
    margin-right: -2em;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }
  .home-article-excerpt {
    margin-top: 14px;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    /* 保留 excerpt 里的换行(用户在 CMS 用回车断句);与 line-clamp 叠加不冲突 */
    white-space: pre-line;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }
  .home-article-meta {
    /* 贴卡片底部:自由空间用 auto 吃掉,文字长时 padding-top 保底间距 */
    margin-top: auto;
    padding-top: 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    width: 100%;
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }
  .home-article-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }
  .home-article-cover-wrap {
    /* 黄金分割小份:(内容宽 - gap) / φ² ≈ 38.2%,文字区 : 封面 = φ : 1 */
    position: relative;
    width: calc((100% - 24px) / 2.618);
    align-self: stretch;
    flex-shrink: 0;
    /* 裁切滑动中的贴片,避免越出封面洗淡标题文字 */
    overflow: hidden;
  }
  .home-article-cover {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* 左缘渐隐进卡片底色(透出 surface,深浅主题自适应)。
       不透明度"先慢后快"但更均缓:保留一点慢起,整体更接近均速(非线性度减弱)。
       范围保持 0→45% 不变,起点完全透明(最左端彻底融没) */
    -webkit-mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0.12) 9%,
      rgba(0, 0, 0, 0.28) 18%,
      rgba(0, 0, 0, 0.46) 27%,
      rgba(0, 0, 0, 0.68) 36%,
      #000 45%
    );
    mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0.12) 9%,
      rgba(0, 0, 0, 0.28) 18%,
      rgba(0, 0, 0, 0.46) 27%,
      rgba(0, 0, 0, 0.68) 36%,
      #000 45%
    );
  }
  /* 悬停封面:真正的磨砂玻璃——backdrop-filter 实时糊化身后的活封面图,再叠一层
     雾面 tint 把它压向"均匀、低对比"。玻璃层从左向右推入(transform + ease-out),
     右缘用蒙版做成柔和玻璃边界。文字层独立叠在其上。
     规则(MVP-PHASE3 教训):backdrop-filter 只写标准属性、不写 -webkit- 配对,
     前缀交给压缩器(lightningcss 成对出现会合并成仅前缀版导致标准属性丢失);
     该层在卡片内、不含 fixed 后代,不会踩"backdrop-filter 制造包含块"害 fixed
     子孙(阅读进度条)的坑。 */
  .home-article-cover-frost {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    /* 比封面宽 240px:柔边蒙版落在封面右缘之外,被父级 overflow:hidden 裁掉——
       到位后封面整块都是均匀磨砂,右缘不再通过蒙版渐隐露出原始锐利底图(踩坑记录);
       滑动中柔边(240px 软渐变)作为推进前沿扫过封面,保留"推过来"手感。
       前沿不用单段线性渐变(会与磨砂本体形成可见分界),而是多 stops 的"消散"曲线:
       磨砂本体保持较实一段,再渐进淡出,融进背后清晰封面(用户指定"交界太明显") */
    width: calc(100% + 240px);
    z-index: 1;
    display: block;
    backdrop-filter: blur(14px) saturate(0.8) brightness(1.04);
    background: color-mix(in srgb, var(--color-surface) 42%, transparent);
    transform: translateX(-100%);
    /* 定稿:比原基准(600ms)稍快,用 var(--duration-slow)=400ms(用户指定"比之前快一点") */
    transition: transform var(--duration-slow) var(--ease-out);
    pointer-events: none;
    will-change: transform, backdrop-filter;
    -webkit-mask-image: linear-gradient(
      to right,
      #000 calc(100% - 240px),
      rgba(0, 0, 0, 0.92) calc(100% - 180px),
      rgba(0, 0, 0, 0.72) calc(100% - 120px),
      rgba(0, 0, 0, 0.45) calc(100% - 60px),
      rgba(0, 0, 0, 0.18) calc(100% - 20px),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      #000 calc(100% - 240px),
      rgba(0, 0, 0, 0.92) calc(100% - 180px),
      rgba(0, 0, 0, 0.72) calc(100% - 120px),
      rgba(0, 0, 0, 0.45) calc(100% - 60px),
      rgba(0, 0, 0, 0.18) calc(100% - 20px),
      transparent 100%
    );
  }
  .home-article-cover-wrap:hover .home-article-cover-frost,
  .home-article-row:focus-visible .home-article-cover-frost {
    transform: translateX(0);
  }
  /* 预览文字:独立于蒙版容器的兄弟层——不参与左缘过渡区,只随悬停整体渐入,
     避免容器蒙版的左羽化把开头文字洗淡 */
  .home-article-cover-preview-text {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    padding: 18px 20px;
    font-size: var(--text-xs);
    line-height: 1.7;
    color: #000;
    /* 正文已在组件里截到 120 字,max-height 仅作溢出兜底 */
    max-height: 120px;
    overflow: hidden;
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-in, ease-in);
    pointer-events: none;
  }
  /* 深色主题下纯黑不可读,回退主题文字色 */
  :global([data-theme='dark']) .home-article-cover-preview-text {
    color: var(--color-text);
  }
  .home-article-cover-wrap:hover .home-article-cover-preview-text,
  .home-article-row:focus-visible .home-article-cover-preview-text {
    opacity: 1;
  }
</style>
