---
// src/components/common/LangSwitch.astro
// 地球图标按钮 + 弹出语言菜单(桌面 header 与移动抽屉共用)
import { locales, type Locale } from '@i18n/config';
import { t, getLocalizedPath } from '@i18n/utils';
import Icon from './Icon.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<div class="langswitch" data-hover-panel>
  <button
    type="button"
    class="langswitch-btn"
    aria-haspopup="true"
    aria-expanded="false"
    aria-label={t(locale, 'langswitch.label')}
    title={t(locale, 'langswitch.label')}
  >
    <Icon name="globe" size={20} />
  </button>
  <nav class="langswitch-menu panel-shell" hidden aria-label={t(locale, 'langswitch.label')}>
    {
      locales.map((l) => (
        <a
          href={getLocalizedPath(Astro.url.pathname, l)}
          aria-current={l === locale ? 'true' : undefined}
          class:list={['langswitch-item', 'panel-shell-item', { active: l === locale }]}
        >
          {t(locale, `langswitch.${l}`)}
        </a>
      ))
    }
  </nav>
</div>

<script>
  // 点击图标开合;点击外部或 Escape 关闭(vanilla,无框架)
  // ClientRouter 导航重建 DOM:元素级绑定随 astro:page-load 重进;
  // document 级监听只绑一次,处理函数内动态查询当前 DOM,避免随导航累积
  function setWrapOpen(wrap: HTMLElement, open: boolean) {
    const menu = wrap.querySelector<HTMLElement>('.langswitch-menu');
    const btn = wrap.querySelector<HTMLButtonElement>('.langswitch-btn');
    if (!menu || !btn) return;
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
  }
  function initLangSwitches() {
    document.querySelectorAll<HTMLElement>('.langswitch').forEach((wrap) => {
      if (wrap.dataset.initialized === 'true') return;
      wrap.dataset.initialized = 'true';
      const btn = wrap.querySelector<HTMLButtonElement>('.langswitch-btn');
      const menu = wrap.querySelector<HTMLElement>('.langswitch-menu');
      if (!btn || !menu) return;
      btn.addEventListener('click', (e) => {
        e.stopPropagation(); // 防止同一 click 冒泡到 document 立即收起
        setWrapOpen(wrap, menu.hidden);
      });
      // 悬停开合(机制在 src/lib/hover-panels.ts)
      wrap.addEventListener('hoverpanel:open', () => setWrapOpen(wrap, true));
      wrap.addEventListener('hoverpanel:close', () => setWrapOpen(wrap, false));
    });
  }
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLElement>('.langswitch').forEach((wrap) => {
      if (!wrap.contains(e.target as Node)) setWrapOpen(wrap, false);
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll<HTMLElement>('.langswitch').forEach((wrap) => {
      const menu = wrap.querySelector<HTMLElement>('.langswitch-menu');
      if (menu && !menu.hidden) {
        setWrapOpen(wrap, false);
        wrap.querySelector<HTMLButtonElement>('.langswitch-btn')?.focus();
      }
    });
  });
  document.addEventListener('astro:page-load', initLangSwitches);
</script>

<style>
  .langswitch {
    position: relative;
  }
  .langswitch-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color calc(var(--duration-fast) * var(--motion-scale)) var(--ease-out);
  }
  .langswitch-btn:hover,
  .langswitch-btn[aria-expanded='true'] {
    color: var(--color-accent);
  }
  /* 材质/圆角/内边距/行样式来自 styles/header-panels.css,这里只管位置与宽度 */
  .langswitch-menu {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    min-width: 160px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    z-index: 10;
  }
  .langswitch-menu[hidden] {
    display: none;
  }
  /* 选中态:accent 圆点 + 文字提亮,由 header-panels.css 的 [aria-current='true'] 负责 */
</style>
