---
// src/components/favorites/AnimeCard.astro
// 卡面只留封面(状态徽章叠右上角)+ 单行标题;评分/感想/外链等详情点卡片进弹窗查看。
import { t } from '@i18n/utils';
import type { Locale } from '@i18n/config';
import type { CollectionEntry } from 'astro:content';
interface Props {
  entry: CollectionEntry<'anime'>;
  locale: Locale;
}
const { entry, locale } = Astro.props;
const {
  title,
  titleOriginal,
  titleZh,
  cover,
  score,
  status,
  comment,
  highlight,
  year,
  episodes,
  episodesWatched,
  studio,
  source,
} = entry.data;
const displayTitle = titleZh || title;
const statusClass = `anime-status-${status}`;
const dialogId = `anime-detail-${entry.id}`;
const showProgress = status === 'watching' && episodes != null && episodes > 0;
---

<div class:list={['anime-card', { highlight }]} data-anime-card data-status={status}>
  <button
    type="button"
    class="anime-card-open"
    data-anime-dialog-open={dialogId}
    aria-haspopup="dialog"
    aria-controls={dialogId}
  >
    <span class="anime-cover-wrap">
      {
        cover ? (
          <img
            src={cover.src}
            alt={displayTitle}
            loading="lazy"
            class="anime-cover"
            data-article-image
          />
        ) : (
          <span class="anime-cover anime-cover-placeholder" data-article-image>
            {displayTitle}
          </span>
        )
      }
      <span class:list={['anime-status-badge', statusClass]}>
        {t(locale, 'anime.status.' + status)}
      </span>
    </span>
    <span class="anime-card-title">{displayTitle}</span>
  </button>
</div>
<dialog class="anime-detail" id={dialogId} aria-label={displayTitle}>
  <button
    type="button"
    class="anime-detail-close"
    data-anime-dialog-close
    aria-label={t(locale, 'common.close')}
  >
    ×
  </button>
  <div class="anime-detail-layout">
    {
      cover && (
        <img
          class="anime-detail-cover"
          src={cover.src}
          alt={displayTitle}
          loading="lazy"
          data-article-image
        />
      )
    }
    <div class="anime-detail-body">
      <h3 class="anime-detail-title">{displayTitle}</h3>
      {
        titleOriginal && titleOriginal !== displayTitle && (
          <p class="anime-detail-original">{titleOriginal}</p>
        )
      }
      <div class="anime-detail-meta">
        <span class:list={['anime-status-badge', 'in-dialog', statusClass]}>
          {t(locale, 'anime.status.' + status)}
        </span>
        {
          score != null && (
            <span class="anime-detail-pair">
              <span class="anime-detail-k">{t(locale, 'anime.score')}</span>
              <span class="anime-detail-v">{score}</span>
            </span>
          )
        }
        {
          year && (
            <span class="anime-detail-pair">
              <span class="anime-detail-k">{t(locale, 'anime.year')}</span>
              <span class="anime-detail-v">{year}</span>
            </span>
          )
        }
        {
          showProgress && (
            <span class="anime-detail-pair">
              <span class="anime-detail-k">{t(locale, 'anime.progress')}</span>
              <span class="anime-detail-v">
                {episodesWatched ?? 0} / {episodes}
              </span>
            </span>
          )
        }
        {
          studio && (
            <span class="anime-detail-pair">
              <span class="anime-detail-v">{studio}</span>
            </span>
          )
        }
      </div>
      {comment && <p class="anime-detail-comment">{comment}</p>}
      {
        source && (
          <a class="anime-detail-link" href={source} target="_blank" rel="noopener noreferrer">
            {t(locale, 'anime.viewOnBangumi')} →
          </a>
        )
      }
    </div>
  </div>
</dialog>

<script>
  // 弹窗开合:window 旗标 + document 委托,ClientRouter 视图切换后依然生效
  // (与 ArticleImageEnhancer 同模式);ESC 由 <dialog> 原生处理
  const DIALOG_FLAG = '__anime_dialog_bound__';
  const w = window as unknown as Record<string, unknown>;
  if (!w[DIALOG_FLAG]) {
    w[DIALOG_FLAG] = true;
    document.addEventListener('click', (e) => {
      const target = e.target as Element | null;
      const opener = target?.closest?.('[data-anime-dialog-open]');
      if (opener) {
        const dlg = document.getElementById(
          opener.getAttribute('data-anime-dialog-open') ?? '',
        ) as HTMLDialogElement | null;
        dlg?.showModal();
        return;
      }
      const closer = target?.closest?.('[data-anime-dialog-close]');
      if (closer) closer.closest('dialog')?.close();
      // 点击 ::backdrop 时事件目标就是 dialog 本身
      if (target instanceof HTMLDialogElement && target.open) target.close();
    });
  }
</script>

<style>
  .anime-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
    transition:
      transform calc(var(--duration-base) * var(--motion-scale)) var(--ease-spring),
      box-shadow calc(var(--duration-base) * var(--motion-scale)) var(--ease-out);
  }
  .anime-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .anime-card.highlight {
    box-shadow: var(--shadow-glow);
    border-color: var(--color-accent);
  }
  .anime-card-open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .anime-cover-wrap {
    position: relative;
    display: block;
  }
  .anime-cover {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }
  .anime-cover-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-xs);
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    background: var(--color-surface-raised);
  }
  .anime-status-badge {
    position: absolute;
    top: var(--spacing-2xs);
    right: var(--spacing-2xs);
    padding: var(--spacing-3xs) var(--spacing-2xs);
    border-radius: var(--radius-sm);
    font-size: var(--text-2xs);
    backdrop-filter: blur(6px);
  }
  .anime-status-finished {
    background: color-mix(in srgb, var(--color-success) 82%, transparent);
    color: #fff;
  }
  .anime-status-watching {
    background: color-mix(in srgb, var(--color-info) 82%, transparent);
    color: #fff;
  }
  .anime-status-planned {
    background: color-mix(in srgb, var(--color-warning) 82%, transparent);
    color: #fff;
  }
  .anime-status-dropped {
    background: color-mix(in srgb, var(--color-text-muted) 82%, transparent);
    color: #fff;
  }
  .anime-card-title {
    display: block;
    padding: var(--spacing-2xs) var(--spacing-xs);
    font-size: var(--text-sm);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .anime-detail {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-text);
    padding: var(--spacing-lg);
    max-width: min(420px, calc(100vw - var(--spacing-xl) * 2));
    box-shadow: var(--shadow-lg);
  }
  .anime-detail::backdrop {
    background: rgb(0 0 0 / 55%);
  }
  .anime-detail-close {
    position: absolute;
    top: var(--spacing-2xs);
    right: var(--spacing-2xs);
    width: var(--spacing-lg);
    height: var(--spacing-lg);
    padding: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: var(--color-surface-raised);
    color: var(--color-text-muted);
    font-size: var(--text-md);
    line-height: 1;
    cursor: pointer;
  }
  .anime-detail-close:hover {
    color: var(--color-text);
  }
  .anime-detail-layout {
    display: flex;
    gap: var(--spacing-md);
  }
  .anime-detail-cover {
    width: 120px;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }
  .anime-detail-title {
    font-size: var(--text-md);
    font-weight: 700;
    padding-right: var(--spacing-lg);
  }
  .anime-detail-original {
    margin-top: var(--spacing-3xs);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .anime-detail-meta {
    margin-top: var(--spacing-xs);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-2xs) var(--spacing-sm);
    font-size: var(--text-xs);
  }
  .anime-status-badge.in-dialog {
    position: static;
    backdrop-filter: none;
  }
  .anime-detail-pair {
    display: inline-flex;
    gap: var(--spacing-3xs);
  }
  .anime-detail-k {
    color: var(--color-text-muted);
  }
  .anime-detail-v {
    color: var(--color-text);
  }
  .anime-detail-comment {
    margin-top: var(--spacing-sm);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    white-space: pre-line;
  }
  .anime-detail-link {
    display: inline-block;
    margin-top: var(--spacing-sm);
    color: var(--color-accent);
    font-size: var(--text-xs);
    text-decoration: none;
  }
</style>
