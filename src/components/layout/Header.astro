---
// src/components/layout/Header.astro
// 全站唯一常驻顶栏(fixed,恒透明):logo + 居中导航 + 右侧图标组,所有页面样式统一。
// 几何规格与首页 Hero 顶栏一致(docs/design/hero-home-spec.md §3):
// 高 64px、logo 24px/400(2026-10-24 起左右改「光学」留白:logo 墨迹距左 = 最右图标
// 墨迹距右 = --header-gutter,当前 29px;顶部留白 23px 由字体行高决定)、
// 34px 按钮、圆心距 44px、四枚图标墨迹中心统一在 y=31.5(原搜索 -2px 抬升已去掉)。
// 取色用壁纸墨色 --hero-ink(壁纸全局铺底,与首页第一屏同观感)。
// 顶栏本体无底色;唯一的一层磨砂是导航链接背后那枚胶囊(.header-nav::before,
// 长度跟随链接组、几何由 --nav-pill-* 控制)。
// - 首页第一屏:中间跳转按钮与磨砂一起淡出(body.home-at-panel 出现时淡入);
//   顶栏本体全程不动。
import { t } from '@i18n/utils';
import { siteConfig } from '@config/site';
import type { Locale } from '@i18n/config';
import SearchBox from '@components/integrations/search/SearchBox.astro';
import MusicPlayerWidget from '@components/integrations/music/MusicPlayerWidget.astro';
import LangSwitch from '../common/LangSwitch.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
import MobileNav from '../ui/MobileNav.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<header class="header">
  <div class="header-inner">
    <a href={`/${locale}/`} class="header-logo">{siteConfig.brand ?? siteConfig.siteName}</a>
    <nav class="header-nav" aria-label={t(locale, 'nav.home')}>
      {
        siteConfig.navItems.map((item) => (
          <a href={`/${locale}${item.href}`} class="header-nav-link">
            {t(locale, item.key)}
          </a>
        ))
      }
    </nav>
    <div class="header-controls">
      <SearchBox locale={locale} />
      <MusicPlayerWidget locale={locale} />
      <ThemeToggle locale={locale} />
      <LangSwitch locale={locale} />
    </div>
    <MobileNav locale={locale} />
  </div>
</header>

<script>
  // 图标组「碰一下就出面板」:统一机制在 src/lib/hover-panels.ts,
  // 四个控件各自监听 hoverpanel:open / close 调自己的开合函数。
  // 首页第二屏会再挂一个 Header,initHoverPanels 内部按元素去重,重复调用无害。
  import { initHoverPanels } from '@lib/hover-panels';
  initHoverPanels();
  document.addEventListener('astro:page-load', initHoverPanels);
</script>

<style>
  .header {
    /* 壁纸墨色覆盖控件取色:与首页 Hero 顶栏同款(弹层面板内部仍用正常主题色) */
    --color-text-muted: rgb(var(--hero-ink) / 0.85);
    --color-text: rgb(var(--hero-ink));
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-header);
    /* 顶栏恒透明(用户要求):任何页面、任何滚动位置都不加底色/磨砂 */
  }
  .header-inner {
    height: 64px;
    display: flex;
    align-items: center;
    /* 图标组贴右缘由 margin-left:auto 保证(与原 Hero 顶栏双元素 space-between 等效;
       若用 space-between,末尾 0 宽的 MobileNav 包装层会吃掉一个间隙槽,
       图标组会被顶离右缘 ~300px) */
    /* 左右内边距都是「光学」值,不是盒子边距:让首字母 N 的墨迹留白(左)= 最右图标的
       墨迹留白(右)= --header-gutter。顶部留白是字体/行高决定的天生基准 23px(字形顶边
       渲染时被吸附到整像素),gutter 取 29 是用户在 21/24/26/29 里试出来的口味值,
       不追求与顶部相等,只要求左右严格对称。
       24px Inter 下两处补偿:N 的字形左边距 2.1px(左内边距 = gutter - 2.1);
       图标在 34px 按钮盒里居中、墨迹比盒子各内缩 8px(右内边距 = gutter - 8)。
       改字号/字体/行高/图标尺寸会挪动这组基准,2.1 与 8 都要重新量
       (量法:截图逐像素扫墨迹,2026-10-24 实测左右均落在 29px) */
    --header-gutter: 29px;
    padding: 0 calc(var(--header-gutter) - 8px) 0 calc(var(--header-gutter) - 2.1px);
  }
  .header-logo {
    /* 同 Hero 顶栏 logo:24px / 400 */
    font-size: 24px;
    font-weight: 400;
    color: var(--color-text);
    text-decoration: none;
  }
  .header-nav {
    /* 绝对居中:不论 logo/图标组宽度,链接组恒在顶栏正中 */
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% 0;
    height: 64px;
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    /* 导航磨砂的占位:调大小只改这两个值 */
    --nav-pill-h: 64px; /* 胶囊高度(垂直居中于 64px 顶栏) */
    --nav-pill-pad: 32px; /* 左右各超出链接组多少 → 决定占位长度 */
  }
  /* 导航磨砂:背景层比链接组大一圈、做成胶囊,blur + saturate 磨砂,四周羽化到 alpha=0。
     遮罩用「胶囊等距衰减」而不是横/纵线性渐变取交集:中段按 y 衰减、两端按半径衰减,
     三层 mask 用 mask-size/position 拼成(中段 + 两个半圆),所以淡出长度可以给得很短
     (--nav-glow-f),轮廓仍然是圆弧而不是竖直线段 */
  .header-nav::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: calc((64px - var(--nav-pill-h)) / 2);
    left: calc(-1 * var(--nav-pill-pad));
    right: calc(-1 * var(--nav-pill-pad));
    height: var(--nav-pill-h);
    border-radius: 999px;
    pointer-events: none;
    background: var(--frost-bg);
    backdrop-filter: blur(18px) saturate(115%);
    --nav-glow-r: calc(var(--nav-pill-h) / 2);
    --nav-glow-f: 20px; /* 离胶囊实心边到 alpha=0 的过渡长度,四周一致 */
    mask-image:
      linear-gradient(
        to bottom,
        transparent 0,
        #000 var(--nav-glow-f),
        #000 calc(100% - var(--nav-glow-f)),
        transparent 100%
      ),
      radial-gradient(
        circle var(--nav-glow-r) at 100% 50%,
        #000 calc(100% - var(--nav-glow-f)),
        transparent 100%
      ),
      radial-gradient(
        circle var(--nav-glow-r) at 0% 50%,
        #000 calc(100% - var(--nav-glow-f)),
        transparent 100%
      );
    mask-size:
      calc(100% - 2 * var(--nav-glow-r)) 100%,
      var(--nav-glow-r) 100%,
      var(--nav-glow-r) 100%;
    mask-position:
      var(--nav-glow-r) 0,
      0 0,
      100% 0;
    mask-repeat: no-repeat;
    transition: opacity calc(var(--duration-slow) * var(--motion-scale)) var(--ease-out);
  }
  .header-nav-link {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    transition:
      color calc(var(--duration-fast) * var(--motion-scale)) var(--ease-out),
      opacity calc(var(--duration-slow) * var(--motion-scale)) var(--ease-out),
      visibility 0s linear;
  }
  .header-nav-link:hover {
    color: var(--color-text);
  }
  .header-controls {
    /* 与 Hero 顶栏图标组同规格:墨色 85%、归一 34px、圆心距 44px
       (原「搜索光学 -2px」已于 2026-10-24 去掉,见下面 .search-toggle 的注释) */
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .header-controls > * {
    width: 34px;
    display: flex;
    justify-content: center;
  }
  .header-controls :global(.search-box) {
    /* 必须显式 flex:`.header-controls > *` 那条 display:flex 会被 SearchBox 自己的
       scoped 样式压掉,于是这层是普通块,里面 34px 的 inline-flex 按钮坐在行盒里,
       包装层被撑到 35.59px 且按钮贴上缘 —— 整枚搜索图标因此比另外三枚高 0.8px */
    width: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .header-controls :global(.search-box .search-toggle) {
    width: 34px;
    height: 34px;
    /* 2026-10-24:原来这里有一条 translate: 0 -2px(设计稿的「搜索光学补偿」),
       但那是照着另一版搜索图标定的;本仓这枚放大镜的墨迹框在 24 viewBox 里本身就是
       3–21(居中),再抬高 2px 会让它的墨迹中心落在 29.5,而另外三枚是 31.5
       —— 肉眼就是「搜索比别的都高」。已去掉,四枚墨迹中心统一在 31.5。 */
  }
  /* 2026-10-25:放大镜的「光学尺寸」补课。同为 20px 渲染,它的墨迹只占 viewBox 的
     20/24(圈 r=8 + 描边,2–22),而地球仪/调色板占 22/24 → 墨迹 16px vs 18px,
     看着小一圈。按墨迹外框对齐到 18×18 反推:20px × 22/20 = 22px。
     stroke 同时按 20/22 折回(2 → 1.82),让绝对线宽仍是 1.67px,只是轮廓变大、不变重。 */
  .header-controls :global(.search-box .search-toggle svg) {
    width: 22px;
    height: 22px;
  }
  .header-controls :global(.search-box .search-toggle svg circle),
  .header-controls :global(.search-box .search-toggle svg path) {
    stroke-width: 1.82;
  }
  /* 首页双屏切换:第一屏无中间跳转按钮(原 Hero 顶栏形态),
     切到第二屏时链接与磨砂随动画一起淡入;顶栏本体全程不动。
     注意:opacity 不能加在 .header-nav 上——那会让它成为 backdrop root,
     过渡期间 ::before 的 backdrop-filter 取不到页面内容,只剩一层底色 */
  :global(body.page-home:not(.home-at-panel)) .header-nav-link {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity calc(var(--duration-slow) * var(--motion-scale)) var(--ease-out),
      visibility 0s linear calc(var(--duration-slow) * var(--motion-scale));
  }
  :global(body.page-home:not(.home-at-panel)) .header-nav::before {
    opacity: 0;
  }
  @media (max-width: 768px) {
    .header-nav,
    .header-controls {
      display: none;
    }
    /* 移动端汉堡贴右(桌面端图标组贴右,无需此规则) */
    .mobile-nav {
      margin-left: auto;
    }
    .header-inner {
      padding: 0 var(--spacing-md);
    }
  }
</style>
