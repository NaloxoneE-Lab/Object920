---
// src/components/layout/BaseLayout.astro
import { ClientRouter } from 'astro:transitions';
import BaseHead from './BaseHead.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Lightbox from '@components/ui/Lightbox.astro';
import Analytics from '@components/integrations/analytics/Analytics.astro';
import MusicHost from '@components/integrations/music/MusicHost.astro';
import MusicPlayerWidget from '@components/integrations/music/MusicPlayerWidget.astro';
import { t } from '@i18n/utils';
import type { Locale } from '@i18n/config';
interface Props {
  locale: Locale;
  title: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  noindex?: boolean;
  robots?: string;
}
const { locale, title, description, ogImage, canonicalURL, noindex, robots } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <BaseHead
      locale={locale}
      title={title}
      description={description}
      ogImage={ogImage}
      canonicalURL={canonicalURL}
      noindex={noindex}
      robots={robots}
    />
    <slot name="head-extras" />
    <!-- ClientRouter:客户端导航 + View Transitions(spec 5.20 P0-8 / spec 7.7 P0-7) -->
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">{t(locale, 'common.skip-to-content')}</a>
    <Header locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <Lightbox locale={locale} />
    <!-- 可插拔 Integration:自闭合标签,功能存在与否对页面结构透明(spec 1.4) -->
    <Analytics />
    <MusicHost>
      <MusicPlayerWidget locale={locale} />
    </MusicHost>
    <span id="copy-live" aria-live="polite" class="sr-only"></span>
    <script>
      import { initArticleImageEnhancer } from '@components/article/ArticleImageEnhancer.ts';
      import { initCodeBlockEnhancer } from '@components/article/CodeBlockEnhancer.ts';
      const ENH_KEY = '__enh_listeners__';
      if (!(window as unknown as Record<string, unknown>)[ENH_KEY]) {
        (window as unknown as Record<string, unknown>)[ENH_KEY] = true;
        document.addEventListener('astro:page-load', () => {
          initArticleImageEnhancer();
          initCodeBlockEnhancer();
        });
      }
    </script>
    <style is:global>
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
    </style>
  </body>
</html>
