---
// src/components/layout/BaseLayout.astro
import { ClientRouter } from 'astro:transitions';
import BaseHead from './BaseHead.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Lightbox from '@components/ui/Lightbox.astro';
import Analytics from '@components/integrations/analytics/Analytics.astro';
import MusicHost from '@components/integrations/music/MusicHost.astro';
import { t } from '@i18n/utils';
import { siteConfig } from '@config/site';
import type { Locale } from '@i18n/config';
interface Props {
  locale: Locale;
  title: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  noindex?: boolean;
  robots?: string;
  /** 首页:第一屏无中间跳转按钮(由 Header 按 body.home-at-panel 控制) */
  home?: boolean;
}
const { locale, title, description, ogImage, canonicalURL, noindex, robots, home } = Astro.props;
const wallpaper = siteConfig.background;
---

<!doctype html>
<html lang={locale}>
  <head>
    <BaseHead
      locale={locale}
      title={title}
      description={description}
      ogImage={ogImage}
      canonicalURL={canonicalURL}
      noindex={noindex}
      robots={robots}
    />
    <slot name="head-extras" />
    <!-- ClientRouter:客户端导航 + View Transitions(spec 5.20 P0-8 / spec 7.7 P0-7) -->
    <ClientRouter />
  </head>
  <body class:list={[{ 'page-home': home, 'has-site-bg': !!wallpaper }]}>
    <!-- 全站统一壁纸层:fixed 铺满视口,内容与顶栏都浮在其上(z-index:-1 垫底,
         不参与命中)。配置为空时整层不渲染,回退主题底色。
         亮/暗两张图都常驻 DOM(不按主题卸载):这样切主题是纯 CSS 显隐、零请求零解码,
         主题切换覆盖层才能直接引用它的 src。data-wallpaper-* 供 theme-wipe 读取 -->
    {
      wallpaper && (
        <div
          class="site-bg"
          aria-hidden="true"
          data-wallpaper-light={wallpaper.light}
          data-wallpaper-dark={wallpaper.dark}
        >
          <img
            class="site-bg-img site-bg-img--light"
            src={wallpaper.light}
            alt=""
            fetchpriority="high"
          />
          <img class="site-bg-img site-bg-img--dark" src={wallpaper.dark} alt="" decoding="async" />
          <div class="site-bg-overlay" />
        </div>
      )
    }
    <!-- 顶栏下的磨砂只在导航链接背后那枚胶囊上(Header 内 .header-nav::before),
         不再有全宽穿越带 -->
    <a href="#main" class="skip-link">{t(locale, 'common.skip-to-content')}</a>
    <Header locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <Lightbox locale={locale} />
    <!-- 可插拔 Integration:自闭合标签,功能存在与否对页面结构透明(spec 1.4) -->
    <Analytics />
    <MusicHost />
    <span id="copy-live" aria-live="polite" class="sr-only"></span>
    <script>
      import { initArticleImageEnhancer } from '@components/article/ArticleImageEnhancer.ts';
      import { initCodeBlockEnhancer } from '@components/article/CodeBlockEnhancer.ts';
      const ENH_KEY = '__enh_listeners__';
      if (!(window as unknown as Record<string, unknown>)[ENH_KEY]) {
        (window as unknown as Record<string, unknown>)[ENH_KEY] = true;
        document.addEventListener('astro:page-load', () => {
          initArticleImageEnhancer();
          initCodeBlockEnhancer();
        });
      }
    </script>
    <style is:global>
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
      /* 全站壁纸:fixed 铺满,滚动的只是内容(像桌面壁纸)。
         暗色主题压暗保浅色墨字可读(与原 Hero 暗色遮罩同参数) */
      .site-bg {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
      }
      .site-bg img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      /* 主题决定显隐,不做 transition:两组图的交接由 theme-wipe 覆盖层负责,
         自己再淡入一次会和覆盖层叠出双重过渡 */
      .site-bg-img--dark {
        opacity: 0;
      }
      [data-theme='dark'] .site-bg-img--light {
        opacity: 0;
      }
      [data-theme='dark'] .site-bg-img--dark {
        opacity: 1;
      }
      .site-bg-overlay {
        position: absolute;
        inset: 0;
        background: transparent;
      }
      /* 深色主题下压暗壁纸,否则壁纸仍是亮色、而正文已切到浅色文字(浅底浅字不可读)。
         遮罩真值在 tokens.css 的 --wallpaper-tint-dark,theme-wipe 与首页磨砂层共用。
         注意:这里在 <style is:global> 里,不能写 :global(...)——那层包装只在 scoped
         style 里会被 Astro 处理,全局块里会原样输出成非法选择器,整条规则被浏览器丢弃 */
      [data-theme='dark'] .site-bg-overlay {
        background: var(--wallpaper-tint-dark);
      }
      /* 常驻顶栏为 fixed,不占文档流:非首页内容下移让出顶栏高度;
         首页第一屏 Hero 从视口顶开始,顶栏悬浮其上 */
      body:not(.page-home) main {
        padding-top: 64px;
      }
      /* 内容磨砂遮罩(非首页):视口固定的磨砂底层,垫在 main 内容与壁纸之间。
         必须挂在 main::before 而非 main 本身——backdrop-filter 会把 main 变成
         fixed 后代(如阅读进度条)的包含块,破坏其视口定位 */
      body:not(.page-home) main::before {
        content: '';
        position: fixed;
        inset: 0;
        z-index: -1;
        background: var(--frost-bg);
        backdrop-filter: blur(var(--frost-blur));
      }
      /* 首页 Footer 不再自带磨砂:垫在 HomePanel 的 .home-panel-frost 视口定层上,
         与非首页 Footer 垫在 main::before 磨砂定层上同构 */
      body.page-home .footer {
        position: relative;
        z-index: 1; /* 与第二屏同层,盖住钉屏 Hero(z 0) */
      }
    </style>
  </body>
</html>
